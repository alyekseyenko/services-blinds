{
  "name": "blinds-technical-services",
  "version": "0.1.0",
  "description": "Offline-first field operations platform for blinds installation companies — CRM sync, routing, measurements, CEO analytics.",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alyekseyenko/services-blinds.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run test",
    "validate:pipeline": "npm run type-check && npm run test -- src/lib/crm/__tests__/pipelineImports.test.ts src/lib/crm/__tests__/pipelineTransitions.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:flow": "playwright test --project=task-flow"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@googlemaps/markerclusterer": "^2.5.3",
    "@react-google-maps/api": "^2.20.8",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "driver.js": "^1.8.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-auth": "^4.24.14",
    "react": "19.2.4",
    "react-big-calendar": "^1.20.0",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
