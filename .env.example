# Twenty CRM
TWENTY_API_URL=http://twenty-server-1:3000
TWENTY_API_KEY=your_twenty_api_key_here
TWENTY_METADATA_URL=http://twenty-server-1:3000/metadata
TWENTY_AUTH_ORIGIN=https://crm.yourcompany.com

# App URLs (production — set real domains only on the server)
NEXT_PUBLIC_APP_URL=https://technicians.yourcompany.com
NEXTAUTH_URL=https://technicians.yourcompany.com
NEXTAUTH_SECRET=generate_a_long_random_secret_here

# Branding (UI / PWA — override on production server)
NEXT_PUBLIC_APP_NAME=ESTORESRAINHA
NEXT_PUBLIC_APP_SHORT_NAME=ESTORESRAINHA
NEXT_PUBLIC_COMPANY_WEBSITE=https://example.com
NEXT_PUBLIC_COMPANY_LABEL=Blinds Technical Services
NEXT_PUBLIC_LOGIN_EMAIL_PLACEHOLDER=user@yourcompany.com
NEXT_PUBLIC_HQ_LABEL=Headquarters
NEXT_PUBLIC_HQ_ADDRESS=Headquarters, Example City
NEXT_PUBLIC_HQ_LAT=38.7223
NEXT_PUBLIC_HQ_LNG=-9.1393
NEXT_PUBLIC_MAP_HQ_TITLE=HQ

# Google Maps (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# n8n webhooks (optional)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_URL_REPORTS=
N8N_WEBHOOK_URL_PUSH=

# Public customer link tokens (optional — falls back to NEXTAUTH_SECRET)
PUBLIC_LINK_SECRET=
PUBLIC_LINK_TTL_DAYS=30

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# E2E Playwright (optional)
# E2E_TECH_EMAIL=technician@example.com
# E2E_TECH_PASSWORD=your_password

# Deploy scripts — local machine only, never commit real values
# VPS_HOST=your.server.ip
# VPS_PASSWORD=...
# DEPLOY_HEALTH_URL=https://technicians.yourcompany.com/api/health
# DEPLOY_CRM_URL=https://crm.yourcompany.com
# NGINX_SITE_PATH=/etc/nginx/sites-available/your-crm-site
# Docker container names (defaults — override only if needed):
# CONTAINER_APP=technician-app
# CONTAINER_REDIS=technician-redis
# CONTAINER_NGINX=technician-nginx
