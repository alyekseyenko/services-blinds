# Twenty CRM Configuration
# No VPS Hetzner dentro da rede Docker use: http://twenty-server-1:3000
TWENTY_API_URL=http://twenty-server-1:3000

# Chave de API do Twenty CRM (gerada em Settings > Developers > API Keys no Twenty)
TWENTY_API_KEY=sua_chave_de_api_twenty_aqui

# Endpoint de metadata do Twenty (login nativo). Por omissão: TWENTY_API_URL/metadata
TWENTY_METADATA_URL=http://twenty-server-1:3000/metadata

# URL pública do Twenty CRM (origin do login). Ex: https://crm.estoresrainha.com
# Se omitido, é obtido automaticamente via API key a partir do workspace.
TWENTY_AUTH_ORIGIN=https://crm.estoresrainha.com

# N8N Webhook (Opcional - caso utilize integrações via n8n)
N8N_WEBHOOK_URL=

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=sua_google_maps_api_key_aqui
NEXT_PUBLIC_APP_URL=https://app.estoresrainha.pt

# NextAuth Configuration
NEXTAUTH_SECRET=gerar_um_secret_aleatorio_longo_aqui
NEXTAUTH_URL=https://app.estoresrainha.pt

# VAPID Keys para Web Push Notifications (Opcional)
# Gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# E2E Playwright (opcional — fluxo técnico autenticado)
# E2E_TECH_EMAIL=tecnico@exemplo.com
# E2E_TECH_PASSWORD=senha_do_tecnico

